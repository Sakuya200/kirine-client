[
  {
    "task": "streaming-speech",
    "base-model": "moss_tts_realtime",
    "params": [
      {
        "name": "temperature",
        "type": "string",
        "componentType": "input-number",
        "componentProps": { "label": "采样温度", "min": 0, "step": 0.05 },
        "required": true,
        "defaultValue": "0.8",
        "description": "MOSS-TTS-Realtime 解码温度，控制生成随机性。值越大多样性越高，默认 0.8。"
      },
      {
        "name": "topP",
        "type": "string",
        "componentType": "input-number",
        "componentProps": { "label": "Top-P", "min": 0, "max": 1, "step": 0.05 },
        "required": true,
        "defaultValue": "0.6",
        "description": "核采样概率阈值，默认 0.6。"
      },
      {
        "name": "topK",
        "type": "number",
        "componentType": "input-number",
        "componentProps": { "label": "Top-K", "min": 0, "step": 1 },
        "required": true,
        "defaultValue": 30,
        "description": "Top-K 采样候选数，默认 30。"
      },
      {
        "name": "repetitionPenalty",
        "type": "string",
        "componentType": "input-number",
        "componentProps": { "label": "重复惩罚", "min": 1, "step": 0.05 },
        "required": true,
        "defaultValue": "1.1",
        "description": "重复惩罚系数，抑制生成重复音频片段，默认 1.1。"
      },
      {
        "name": "repetitionWindow",
        "type": "number",
        "componentType": "input-number",
        "componentProps": { "label": "重复窗口", "min": 1, "step": 1 },
        "required": true,
        "defaultValue": 50,
        "description": "重复惩罚作用的滑动窗口长度，默认 50。"
      },
      {
        "name": "maxLength",
        "type": "number",
        "componentType": "input-number",
        "componentProps": { "label": "最大生成长度", "min": 1, "step": 1024 },
        "required": true,
        "defaultValue": 32768,
        "description": "单条消息最大生成 token 长度上限，默认 32768。"
      },
      {
        "name": "enableTorchCompile",
        "type": "string",
        "componentType": "select",
        "componentProps": {
          "label": "Torch Compile",
          "options": [
            { "label": "自动", "value": "auto" },
            { "label": "启用", "value": "true" },
            { "label": "禁用", "value": "false" }
          ]
        },
        "required": true,
        "defaultValue": "auto",
        "description": "是否启用 torch.compile。自动模式下非 Windows 默认启用，Windows 默认关闭。"
      },
      {
        "name": "dtype",
        "type": "string",
        "componentType": "select",
        "componentProps": {
          "label": "推理精度",
          "options": [
            { "label": "自动", "value": "auto" },
            { "label": "BF16", "value": "bf16" },
            { "label": "FP16", "value": "fp16" },
            { "label": "FP32", "value": "fp32" }
          ]
        },
        "required": true,
        "defaultValue": "auto",
        "description": "模型推理主精度。auto 会按当前设备自动选择合适 dtype。"
      },
      {
        "name": "float32MatmulPrecision",
        "type": "string",
        "componentType": "select",
        "componentProps": {
          "label": "FP32 Matmul 精度策略",
          "options": [
            { "label": "High（推荐）", "value": "high" },
            { "label": "Highest", "value": "highest" },
            { "label": "Medium", "value": "medium" },
            { "label": "关闭设置", "value": "off" }
          ]
        },
        "required": true,
        "defaultValue": "high",
        "description": "仅影响 FP32 matmul 的内核策略，不改变模型主权重 dtype。"
      }
    ]
  }
]
