[
  {
    "task": "streaming-speech",
    "base-model": "moss_tts_realtime",
    "params": [
      {
        "name": "temperature",
        "type": "string",
        "componentType": "input-number",
        "componentProps": { "label": "采样温度", "min": 0, "step": 0.05 },
        "required": true,
        "defaultValue": "0.8",
        "description": "MOSS-TTS-Realtime 解码温度，控制生成随机性。值越大多样性越高，默认 0.8。"
      },
      {
        "name": "topP",
        "type": "string",
        "componentType": "input-number",
        "componentProps": { "label": "Top-P", "min": 0, "max": 1, "step": 0.05 },
        "required": true,
        "defaultValue": "0.6",
        "description": "核采样概率阈值，默认 0.6。"
      },
      {
        "name": "topK",
        "type": "number",
        "componentType": "input-number",
        "componentProps": { "label": "Top-K", "min": 0, "step": 1 },
        "required": true,
        "defaultValue": 30,
        "description": "Top-K 采样候选数，默认 30。"
      },
      {
        "name": "repetitionPenalty",
        "type": "string",
        "componentType": "input-number",
        "componentProps": { "label": "重复惩罚", "min": 1, "step": 0.05 },
        "required": true,
        "defaultValue": "1.1",
        "description": "重复惩罚系数，抑制生成重复音频片段，默认 1.1。"
      },
      {
        "name": "repetitionWindow",
        "type": "number",
        "componentType": "input-number",
        "componentProps": { "label": "重复窗口", "min": 1, "step": 1 },
        "required": true,
        "defaultValue": 50,
        "description": "重复惩罚作用的滑动窗口长度，默认 50。"
      },
      {
        "name": "maxLength",
        "type": "number",
        "componentType": "input-number",
        "componentProps": { "label": "最大生成长度", "min": 1, "step": 1024 },
        "required": true,
        "defaultValue": 32768,
        "description": "单条消息最大生成 token 长度上限，默认 32768。"
      }
    ]
  },
  {
    "task": "model-training",
    "base-model": "moss_tts_realtime",
    "params": [
      {
        "name": "epochCount",
        "type": "number",
        "componentType": "input-number",
        "componentProps": { "label": "训练轮次", "min": 1, "step": 1 },
        "required": true,
        "defaultValue": 3,
        "description": "训练 epoch 数（--num-epochs）。"
      },
      {
        "name": "batchSize",
        "type": "number",
        "componentType": "input-number",
        "componentProps": { "label": "批次大小", "min": 1, "step": 1 },
        "required": true,
        "defaultValue": 1,
        "description": "每设备 batch size（--per-device-batch-size）。显存不足时调小。"
      },
      {
        "name": "gradientAccumulationSteps",
        "type": "number",
        "componentType": "input-number",
        "componentProps": { "label": "梯度累积步数", "min": 1, "step": 1 },
        "required": true,
        "defaultValue": 8,
        "description": "梯度累积步数（--gradient-accumulation-steps），等效增大 batch size。"
      },
      {
        "name": "learningRate",
        "type": "string",
        "componentType": "input-number",
        "componentProps": { "label": "学习率", "min": 0, "step": 0.000001 },
        "required": true,
        "defaultValue": "1e-5",
        "description": "训练学习率（--learning-rate），SFT 建议 1e-5 量级。"
      },
      {
        "name": "weightDecay",
        "type": "string",
        "componentType": "input-number",
        "componentProps": { "label": "权重衰减", "min": 0, "step": 0.001 },
        "required": true,
        "defaultValue": "0.1",
        "description": "权重衰减系数（--weight-decay），默认 0.1。"
      },
      {
        "name": "warmupRatio",
        "type": "string",
        "componentType": "input-number",
        "componentProps": { "label": "预热比例", "min": 0, "max": 1, "step": 0.01 },
        "required": true,
        "defaultValue": "0.03",
        "description": "学习率预热比例（--warmup-ratio），默认 0.03。"
      },
      {
        "name": "mixedPrecision",
        "type": "string",
        "componentType": "select",
        "componentProps": {
          "label": "混合精度",
          "options": [
            { "label": "bfloat16", "value": "bf16" },
            { "label": "float16", "value": "fp16" }
          ]
        },
        "required": true,
        "defaultValue": "bf16",
        "description": "训练混合精度（--mixed-precision）。bf16 推荐 NVIDIA 较新显卡；fp16 兼容性更广。"
      },
      {
        "name": "maxGradNorm",
        "type": "string",
        "componentType": "input-number",
        "componentProps": { "label": "最大梯度范数", "min": 0, "step": 0.1 },
        "required": true,
        "defaultValue": "1.0",
        "description": "梯度裁剪最大范数（--max-grad-norm），默认 1.0。"
      }
    ]
  }
]
