[
  {
    "task": "streaming-speech",
    "base-model": "moss_tts_realtime",
    "params": [
      {
        "name": "temperature",
        "type": "string",
        "componentType": "input-number",
        "componentProps": { "label": "采样温度", "min": 0, "step": 0.05 },
        "required": true,
        "defaultValue": "0.8",
        "description": "MOSS-TTS-Realtime 解码温度，控制生成随机性。值越大多样性越高，默认 0.8。"
      },
      {
        "name": "topP",
        "type": "string",
        "componentType": "input-number",
        "componentProps": { "label": "Top-P", "min": 0, "max": 1, "step": 0.05 },
        "required": true,
        "defaultValue": "0.6",
        "description": "核采样概率阈值，默认 0.6。"
      },
      {
        "name": "topK",
        "type": "number",
        "componentType": "input-number",
        "componentProps": { "label": "Top-K", "min": 0, "step": 1 },
        "required": true,
        "defaultValue": 30,
        "description": "Top-K 采样候选数，默认 30。"
      },
      {
        "name": "repetitionPenalty",
        "type": "string",
        "componentType": "input-number",
        "componentProps": { "label": "重复惩罚", "min": 1, "step": 0.05 },
        "required": true,
        "defaultValue": "1.1",
        "description": "重复惩罚系数，抑制生成重复音频片段，默认 1.1。"
      },
      {
        "name": "repetitionWindow",
        "type": "number",
        "componentType": "input-number",
        "componentProps": { "label": "重复窗口", "min": 1, "step": 1 },
        "required": true,
        "defaultValue": 50,
        "description": "重复惩罚作用的滑动窗口长度，默认 50。"
      },
      {
        "name": "maxLength",
        "type": "number",
        "componentType": "input-number",
        "componentProps": { "label": "最大生成长度", "min": 1, "step": 1024 },
        "required": true,
        "defaultValue": 32768,
        "description": "单条消息最大生成 token 长度上限，默认 32768。"
      }
    ]
  }
]
