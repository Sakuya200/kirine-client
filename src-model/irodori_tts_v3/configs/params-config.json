[
  {
    "task": "text-to-speech",
    "base-model": "irodori_tts_v3",
    "params": [
      {
        "name": "numSteps",
        "type": "number",
        "componentType": "input-number",
        "componentProps": { "label": "推理步数", "min": 1, "step": 1 },
        "required": true,
        "defaultValue": 40,
        "description": "Irodori-TTS 流匹配（RF Euler）采样步数。步数越大质量越高但速度越慢，默认 40。"
      },
      {
        "name": "cfgScaleText",
        "type": "string",
        "componentType": "input-number",
        "componentProps": { "label": "文本引导强度", "min": 0, "step": 0.1 },
        "required": true,
        "defaultValue": "3.0",
        "description": "文本条件 CFG 强度（--cfg-scale-text）。值越大文本贴合度越高，过大可能失真。"
      },
      {
        "name": "cfgScaleSpeaker",
        "type": "string",
        "componentType": "input-number",
        "componentProps": { "label": "说话人引导强度", "min": 0, "step": 0.1 },
        "required": true,
        "defaultValue": "5.0",
        "description": "说话人条件 CFG 强度（--cfg-scale-speaker）。值越大音色匹配越强，仅在存在参考说话人时生效。"
      },
      {
        "name": "modelPrecision",
        "type": "string",
        "componentType": "select",
        "componentProps": {
          "label": "推理精度",
          "options": [
            { "label": "float32", "value": "fp32" },
            { "label": "bfloat16", "value": "bf16" }
          ]
        },
        "required": true,
        "defaultValue": "fp32",
        "description": "模型加载与推理精度。bf16 显存占用低、速度快，推荐支持 BF16 的 NVIDIA 显卡；float32 精度最高但显存占用与耗时显著增加，CPU 仅建议 float32。"
      },
      {
        "name": "durationScale",
        "type": "string",
        "componentType": "input-number",
        "componentProps": { "label": "时长缩放", "min": 0.1, "step": 0.1 },
        "required": true,
        "defaultValue": "1.0",
        "description": "预测时长缩放系数（--duration-scale）。>1 拉长语速变慢，<1 缩短语速变快。"
      },
      {
        "name": "numCandidates",
        "type": "number",
        "componentType": "input-number",
        "componentProps": { "label": "候选数量", "min": 1, "step": 1 },
        "required": true,
        "defaultValue": 1,
        "description": "单次批量采样生成的候选数（--num-candidates）。>1 时输出多个候选音频。"
      },
      {
        "name": "seed",
        "type": "number",
        "componentType": "input-number",
        "componentProps": { "label": "随机种子", "min": 0, "step": 1, "nullable": true },
        "required": false,
        "defaultValue": null,
        "description": "采样随机种子（--seed）。留空则每次随机生成。"
      }
    ]
  },
