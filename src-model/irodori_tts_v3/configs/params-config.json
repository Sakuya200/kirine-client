  {
    "task": "voice-design",
    "base-model": "irodori_tts_v3",
    "params": [
      {
        "name": "numSteps",
        "type": "number",
        "componentType": "input-number",
        "componentProps": { "label": "推理步数", "min": 1, "step": 1 },
        "required": true,
        "defaultValue": 40,
        "description": "Irodori-TTS 流匹配（RF Euler）采样步数。步数越大质量越高但速度越慢，默认 40。"
      },
      {
        "name": "cfgScaleText",
        "type": "string",
        "componentType": "input-number",
        "componentProps": { "label": "文本引导强度", "min": 0, "step": 0.1 },
        "required": true,
        "defaultValue": "3.0",
        "description": "文本条件 CFG 强度（--cfg-scale-text）。"
      },
      {
        "name": "cfgScaleCaption",
        "type": "string",
        "componentType": "input-number",
        "componentProps": { "label": "音色描述引导强度", "min": 0, "step": 0.1 },
        "required": true,
        "defaultValue": "3.0",
        "description": "音色描述（caption）条件 CFG 强度（--cfg-scale-caption）。值越大音色风格贴合度越高。"
      },
      {
        "name": "cfgScaleSpeaker",
        "type": "string",
        "componentType": "input-number",
        "componentProps": { "label": "说话人引导强度", "min": 0, "step": 0.1 },
        "required": true,
        "defaultValue": "5.0",
        "description": "说话人条件 CFG 强度（--cfg-scale-speaker）。仅在提供参考音频（3 分支模式）时生效。"
      },
      {
        "name": "modelPrecision",
        "type": "string",
        "componentType": "select",
        "componentProps": {
          "label": "推理精度",
          "options": [
            { "label": "float32", "value": "fp32" },
            { "label": "bfloat16", "value": "bf16" }
          ]
        },
        "required": true,
        "defaultValue": "fp32",
        "description": "模型加载与推理精度。bf16 显存占用低、速度快；float32 精度最高但显存占用与耗时显著增加，CPU 仅建议 float32。"
      },
      {
        "name": "durationScale",
        "type": "string",
        "componentType": "input-number",
        "componentProps": { "label": "时长缩放", "min": 0.1, "step": 0.1 },
        "required": true,
        "defaultValue": "1.0",
        "description": "预测时长缩放系数（--duration-scale）。"
      },
      {
        "name": "numCandidates",
        "type": "number",
        "componentType": "input-number",
        "componentProps": { "label": "候选数量", "min": 1, "step": 1 },
        "required": true,
        "defaultValue": 1,
        "description": "单次批量采样生成的候选数（--num-candidates）。"
      },
      {
        "name": "seed",
        "type": "number",
        "componentType": "input-number",
        "componentProps": { "label": "随机种子", "min": 0, "step": 1, "nullable": true },
        "required": false,
        "defaultValue": null,
        "description": "采样随机种子（--seed）。留空则每次随机生成。"
      },
      {
        "name": "refAudioPath",
        "type": "string",
        "componentType": "input-audio-file",
        "componentProps": {
          "label": "参考音频（可选）",
          "helpText": "可选。提供参考音频时使用 text+ref+caption 三分支模式，音色更贴近参考；不提供则使用纯 caption 模式。",
          "placeholder": "尚未选择参考音频",
          "dialogTitle": "选择参考音频",
          "buttonText": "选择参考音频",
          "extensions": ["wav", "mp3", "flac", "m4a", "ogg"]
        },
        "required": false,
        "defaultValue": "",
        "description": "音色设计可选参考音频。提供时启用三分支模式（--ref-wav），否则纯 caption 模式（--no-ref）。"
      }
    ]
  },
  {
    "task": "model-training",
    "base-model": "irodori_tts_v3",
    "params": [
      {
        "name": "trainingMode",
        "type": "string",
        "componentType": "select",
        "componentProps": {
          "label": "微调模式",
          "options": [
            { "label": "Speaker Inversion（说话人嵌入）", "value": "speaker_inversion" },
            { "label": "LoRA 微调", "value": "lora" }
          ]
        },
        "required": true,
        "defaultValue": "speaker_inversion",
        "description": "微调模式。Speaker Inversion 冻结模型、训练 16 个说话人嵌入 token，产出 .speaker.safetensors，可用于说话人 TTS；LoRA 微调低秩适配模型权重，产出适配器目录。"
      },
      {
        "name": "epochCount",
        "type": "number",
        "componentType": "input-number",
        "componentProps": { "label": "训练轮次", "min": 1, "step": 1 },
        "required": true,
        "defaultValue": 5,
        "description": "训练 epoch 数，用于换算最大训练步数（max_steps ≈ epoch × 样本数 / (batch × 梯度累积)）。"
      },
      {
        "name": "batchSize",
        "type": "number",
        "componentType": "input-number",
        "componentProps": { "label": "批次大小", "min": 1, "step": 1 },
        "required": true,
        "defaultValue": 1,
        "description": "每个训练 step 的 batch size。显存不足时调小。"
      },
      {
        "name": "gradientAccumulationSteps",
        "type": "number",
        "componentType": "input-number",
        "componentProps": { "label": "梯度累积步数", "min": 1, "step": 1 },
        "required": true,
        "defaultValue": 1,
        "description": "梯度累积步数，等效增大 batch size。"
      },
      {
        "name": "learningRate",
        "type": "string",
        "componentType": "input-number",
        "componentProps": { "label": "学习率", "min": 0, "step": 0.000001 },
        "required": true,
        "defaultValue": "1e-3",
        "description": "训练学习率。Speaker Inversion 建议 1e-2 ~ 1e-3；LoRA 建议 1e-4。"
      },
      {
        "name": "maxSteps",
        "type": "number",
        "componentType": "input-number",
        "componentProps": { "label": "最大训练步数", "min": 1, "step": 1, "nullable": true },
        "required": false,
        "defaultValue": null,
        "description": "最大训练步数（--max-steps）。留空则按训练轮次换算；填写后覆盖轮次换算结果。"
      },
      {
        "name": "enableGradientCheckpointing",
        "type": "boolean",
        "componentType": "switch",
        "componentProps": { "label": "梯度检查点", "text": "启用梯度检查点" },
        "required": true,
        "defaultValue": true,
        "description": "启用 gradient checkpointing，节省显存但略微降低训练速度。"
      },
      {
        "name": "loraR",
        "type": "number",
        "componentType": "input-number",
        "componentProps": {
          "label": "LoRA 秩",
          "min": 1,
          "step": 1,
          "visibleWhen": { "field": "trainingMode", "equals": "lora" }
        },
        "required": true,
        "defaultValue": 16,
        "description": "LoRA 秩（--lora-r）。仅在 LoRA 模式下生效。"
      },
      {
        "name": "loraAlpha",
        "type": "number",
        "componentType": "input-number",
        "componentProps": {
          "label": "LoRA Alpha",
          "min": 1,
          "step": 1,
          "visibleWhen": { "field": "trainingMode", "equals": "lora" }
        },
        "required": true,
        "defaultValue": 32,
        "description": "LoRA alpha（--lora-alpha）。仅在 LoRA 模式下生效。"
      }
    ]
  }
]
