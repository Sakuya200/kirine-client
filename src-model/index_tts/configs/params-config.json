[
  {
    "task": "text-to-speech",
    "base-model": "index_tts",
    "params": [
      {
        "name": "refAudioPath",
        "type": "string",
        "componentType": "input-audio-file",
        "componentProps": {
          "label": "参考音频",
          "helpText": "选择 3 到 10 秒左右的参考音频文件，用于克隆音色。",
          "placeholder": "尚未选择参考音频",
          "dialogTitle": "选择参考音频",
          "buttonText": "选择参考音频",
          "extensions": ["wav", "mp3", "flac", "m4a", "ogg"]
        },
        "required": true,
        "defaultValue": "",
        "description": "IndexTTS 推理所需的参考音频路径。"
      },
      {
        "name": "emotionSource",
        "type": "string",
        "componentType": "select",
        "componentProps": {
          "label": "情感来源",
          "options": [
            { "label": "不控制（跟随参考音频）", "value": "none" },
            { "label": "情感参考音频", "value": "audio" },
            { "label": "情感文本描述", "value": "text" },
            { "label": "八维情感向量", "value": "vector" }
          ]
        },
        "required": true,
        "defaultValue": "none",
        "description": "情感控制方式：不控制 / 参考音频 / 文本描述 / 八维向量。"
      },
      {
        "name": "emoAudioPath",
        "type": "string",
        "componentType": "input-audio-file",
        "componentProps": {
          "label": "情感参考音频",
          "helpText": "选择承载目标情感的参考音频，音色仍由上方参考音频决定。",
          "placeholder": "尚未选择情感参考音频",
          "dialogTitle": "选择情感参考音频",
          "buttonText": "选择情感音频",
          "extensions": ["wav", "mp3", "flac", "m4a", "ogg"],
          "visibleWhen": { "field": "emotionSource", "equals": "audio" }
        },
        "required": true,
        "defaultValue": "",
        "description": "情感参考音频路径，仅在情感来源为“情感参考音频”时生效。"
      },
      {
        "name": "emoText",
        "type": "string",
        "componentType": "textarea",
        "componentProps": {
          "label": "情感描述文本",
          "helpText": "用自然语言描述目标情感，模型自动解析为情感向量（加载 QwenEmotion 附加模型）。",
          "placeholder": "例如：用轻柔舒缓、略带愉悦的语气说话",
          "rows": 2,
          "visibleWhen": { "field": "emotionSource", "equals": "text" }
        },
        "required": true,
        "defaultValue": "",
        "description": "情感描述文本，仅在情感来源为“情感文本描述”时生效。"
      },
      {
        "name": "emoJoy",
        "type": "number",
        "componentType": "input-number",
        "componentProps": {
          "label": "高兴",
          "min": 0,
          "max": 1,
          "step": 0.05,
          "visibleWhen": { "field": "emotionSource", "equals": "vector" }
        },
        "required": true,
        "defaultValue": 0,
        "description": "情感向量·高兴分量。"
      },
      {
        "name": "emoAnger",
        "type": "number",
        "componentType": "input-number",
        "componentProps": {
          "label": "愤怒",
          "min": 0,
          "max": 1,
          "step": 0.05,
          "visibleWhen": { "field": "emotionSource", "equals": "vector" }
        },
        "required": true,
        "defaultValue": 0,
        "description": "情感向量·愤怒分量。"
      },
      {
        "name": "emoSadness",
        "type": "number",
        "componentType": "input-number",
        "componentProps": {
          "label": "悲伤",
          "min": 0,
          "max": 1,
          "step": 0.05,
          "visibleWhen": { "field": "emotionSource", "equals": "vector" }
        },
        "required": true,
        "defaultValue": 0,
        "description": "情感向量·悲伤分量。"
      },
      {
        "name": "emoFear",
        "type": "number",
        "componentType": "input-number",
        "componentProps": {
          "label": "恐惧",
          "min": 0,
          "max": 1,
          "step": 0.05,
          "visibleWhen": { "field": "emotionSource", "equals": "vector" }
        },
        "required": true,
        "defaultValue": 0,
        "description": "情感向量·恐惧分量。"
      },
      {
        "name": "emoDisgust",
        "type": "number",
        "componentType": "input-number",
        "componentProps": {
          "label": "厌恶",
          "min": 0,
          "max": 1,
          "step": 0.05,
          "visibleWhen": { "field": "emotionSource", "equals": "vector" }
        },
        "required": true,
        "defaultValue": 0,
        "description": "情感向量·厌恶分量。"
      },
      {
        "name": "emoMelancholy",
        "type": "number",
        "componentType": "input-number",
        "componentProps": {
          "label": "忧郁",
          "min": 0,
          "max": 1,
          "step": 0.05,
          "visibleWhen": { "field": "emotionSource", "equals": "vector" }
        },
        "required": true,
        "defaultValue": 0,
        "description": "情感向量·忧郁分量。"
      },
      {
        "name": "emoSurprise",
        "type": "number",
        "componentType": "input-number",
        "componentProps": {
          "label": "惊讶",
          "min": 0,
          "max": 1,
          "step": 0.05,
          "visibleWhen": { "field": "emotionSource", "equals": "vector" }
        },
        "required": true,
        "defaultValue": 0,
        "description": "情感向量·惊讶分量。"
      },
      {
        "name": "emoCalm",
        "type": "number",
        "componentType": "input-number",
        "componentProps": {
          "label": "平静",
          "min": 0,
          "max": 1,
          "step": 0.05,
          "visibleWhen": { "field": "emotionSource", "equals": "vector" }
        },
        "required": true,
        "defaultValue": 0,
        "description": "情感向量·平静分量。"
      },
      {
        "name": "emoAlpha",
        "type": "number",
        "componentType": "input-number",
        "componentProps": {
          "label": "情感强度",
          "helpText": "0 到 1 之间的情感混合强度，仅在启用情感控制时生效，不控制时忽略。",
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "required": true,
        "defaultValue": 1.0,
        "description": "情感混合强度 emo_alpha。"
      },
      {
        "name": "useRandom",
        "type": "boolean",
        "componentType": "switch",
        "componentProps": {
          "label": "随机情感采样",
          "text": "启用随机采样",
          "helpText": "开启后情感从候选中随机采样，可能降低音色与情感的还原度。"
        },
        "required": true,
        "defaultValue": false,
        "description": "是否随机采样情感向量。"
      },
      {
        "name": "durationFactor",
        "type": "number",
        "componentType": "input-number",
        "componentProps": {
          "label": "时长倍率",
          "helpText": "0.5 到 2.0 之间的语速控制，大于 1 更慢、小于 1 更快。仅 2.5 版本生效，2.0 忽略。",
          "min": 0.5,
          "max": 2,
          "step": 0.1
        },
        "required": true,
        "defaultValue": 1.0,
        "description": "输出时长倍率 duration_factor（仅 2.5）。"
      },
      {
        "name": "halfPrecision",
        "type": "boolean",
        "componentType": "switch",
        "componentProps": {
          "label": "半精度推理",
          "text": "启用半精度",
          "helpText": "2.0 使用 FP16、2.5 使用 BF16；CPU 设备下自动禁用。"
        },
        "required": true,
        "defaultValue": true,
        "description": "是否启用半精度推理。"
      }
    ]
  },
